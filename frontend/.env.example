# =============================================================================
# SkillBridge frontend — environment template
# =============================================================================
#   cp .env.example .env.local
#
# WARNING: every NEXT_PUBLIC_ variable is inlined into the JavaScript bundle and
# is readable by anyone who opens the site. Public configuration only — never an
# API key, token or secret. All privileged calls (AI providers, storage, email)
# are made by the backend, never by the browser.

# Base URL of the SkillBridge API, no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public origin of this site, used for canonical URLs and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Display name shown in the header and page titles.
NEXT_PUBLIC_APP_NAME=SkillBridge
