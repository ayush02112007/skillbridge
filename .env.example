# =============================================================================
# SkillBridge — environment template
# =============================================================================
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#   docker compose up --build
#
# Every value below has a safe development default baked into the application,
# so an empty `.env` still boots. The values marked REQUIRED-IN-PRODUCTION are
# enforced at startup: the API refuses to start in production if they are left
# at their development defaults (see backend/app/core/config.py:validate_runtime).
#
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# -----------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
APP_NAME=SkillBridge
APP_SUBTITLE=Academia-Industry Collaboration & Employability Platform
API_V1_PREFIX=/api/v1
ENVIRONMENT=development                  # development | staging | production
DEBUG=true                               # must be false in production
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                           # true emits structured JSON logs

# --- Database ----------------------------------------------------------------
# Docker Compose: postgres. Local without Docker: sqlite+aiosqlite:///./var/skillbridge.db
DATABASE_URL=postgresql+asyncpg://skillbridge:skillbridge_dev_password@postgres:5432/skillbridge
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=skillbridge_dev_password   # REQUIRED-IN-PRODUCTION
POSTGRES_DB=skillbridge
POSTGRES_PORT=5432
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# --- Cache & background jobs -------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false           # true runs jobs inline (no worker needed)

# --- Authentication ----------------------------------------------------------
# REQUIRED-IN-PRODUCTION: both secrets must be unique, random and different.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
JWT_REFRESH_SECRET=dev-only-insecure-refresh-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
EMAIL_VERIFICATION_EXPIRE_HOURS=48
PASSWORD_RESET_EXPIRE_MINUTES=60
PASSWORD_MIN_LENGTH=10
REQUIRE_EMAIL_VERIFICATION=false         # true in production
MAX_ACTIVE_SESSIONS=10

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10            # login / register / reset bucket
RATE_LIMIT_WRITE_PER_MINUTE=60

# --- URLs, CORS & cookies ----------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # never "*" in production
TRUSTED_HOSTS=*                          # REQUIRED-IN-PRODUCTION: real hostnames
CSRF_ENABLED=true
SECURE_COOKIES=false                     # true in production (HTTPS only)
COOKIE_DOMAIN=

# --- Email -------------------------------------------------------------------
# console  → prints to the log (default, nothing leaves the machine)
# smtp     → Mailpit in Compose; a real relay in production
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@skillbridge.local
EMAIL_FROM_NAME=SkillBridge
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_API_KEY=                           # sendgrid / ses / resend API key

# --- File storage ------------------------------------------------------------
STORAGE_PROVIDER=s3                      # local | s3 (MinIO is S3-compatible)
STORAGE_LOCAL_PATH=./var/uploads
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=skillbridge
S3_SECRET_KEY=skillbridge_dev_secret     # REQUIRED-IN-PRODUCTION
S3_BUCKET=skillbridge
S3_USE_SSL=false
SIGNED_URL_EXPIRE_SECONDS=900            # documents are served via expiring URLs
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_MIME=application/pdf,image/png,image/jpeg,image/webp,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
VIRUS_SCAN_ENABLED=false

# --- AI ----------------------------------------------------------------------
# deterministic → no external calls; scoring, matching, gap analysis and
# learning paths are computed locally. This is the default and the platform is
# fully functional without any API key. openai/anthropic/local only add
# narrative phrasing on top of the deterministic numbers.
AI_PROVIDER=deterministic                # deterministic | openai | anthropic | local
AI_API_KEY=                              # server-side only — never exposed to the browser
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
AI_ENABLE_LLM_NARRATIVES=true

# --- Matching weights (must sum to exactly 1.0) ------------------------------
MATCH_WEIGHT_SKILLS=0.50
MATCH_WEIGHT_EDUCATION=0.15
MATCH_WEIGHT_INTEREST=0.10
MATCH_WEIGHT_EXPERIENCE=0.10
MATCH_WEIGHT_LOCATION=0.05
MATCH_WEIGHT_CERTIFICATION=0.05
MATCH_WEIGHT_PROJECT=0.05

# --- Seeding -----------------------------------------------------------------
# Demo accounts (student@demo.com, industry@demo.com, faculty@demo.com,
# institution@demo.com, admin@demo.com) all share this password.
# They are development fixtures. The seeder refuses to run when
# ENVIRONMENT=production. Never use these credentials in production.
SEED_ON_START=true
SEED_DEMO_PASSWORD=DemoPass!2024

# --- Frontend (build-time; these ARE shipped to the browser) -----------------
# Only put public values here. Never place an API key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SkillBridge
